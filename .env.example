# ═══════════════════════════════════════════════════════════
# MIA Medical Italia — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ─── APP ──────────────────────────────────────────────────
NODE_ENV=development                      # development | staging | production
PORT=3000                                 # API server port
APP_URL=http://localhost:3000             # Public URL of this API
API_PREFIX=api/v1                         # Global API prefix
APP_NAME="MIA Medical Italia"
APP_TIMEZONE=Europe/Rome
CORS_ORIGINS=http://localhost:3001,http://localhost:3002  # Comma-separated allowed origins

# ─── DATABASE (PostgreSQL 16+ with PostGIS) ──────────────
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=mia_medical
DB_USERNAME=mia_dev
DB_PASSWORD=mia_dev_pass
DB_SSL=false                              # true in production
DB_LOGGING=true                           # SQL query logging (disable in prod)
DB_POOL_MAX=20                            # Connection pool max
DB_POOL_MIN=5                             # Connection pool min

# ─── REDIS ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                           # Empty for local dev
REDIS_DB=0                                # Redis database number
REDIS_KEY_PREFIX=mia:                     # Key namespace prefix

# ─── JWT (Authentication) ────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m                     # Access token expiry (15 minutes)
JWT_REFRESH_EXPIRY=30d                    # Refresh token expiry (30 days)

# ─── SPID (Italian digital identity — SAML 2.0) ─────────
SPID_ENABLED=false                        # Enable SPID authentication
SPID_ENTITY_ID=https://miamedicalitalia.it
SPID_CERT_PATH=./certs/spid-cert.pem     # X.509 certificate path
SPID_KEY_PATH=./certs/spid-key.pem       # Private key path
SPID_CALLBACK_URL=https://api.miamedicalitalia.it/api/v1/auth/spid/callback
SPID_LOGOUT_URL=https://miamedicalitalia.it/login
# SPID IdP metadata URLs (test environment)
SPID_IDP_METADATA_URL=https://idp.spid.gov.it/metadata
# SPID Level: SpidL1 (basic) or SpidL2 (with 2FA)
SPID_AUTH_LEVEL=SpidL2

# ─── CIE (Italian electronic ID card — SAML 2.0) ────────
CIE_ENABLED=false                         # Enable CIE authentication
CIE_ENTITY_ID=https://miamedicalitalia.it
CIE_CERT_PATH=./certs/cie-cert.pem
CIE_KEY_PATH=./certs/cie-key.pem
CIE_CALLBACK_URL=https://api.miamedicalitalia.it/api/v1/auth/cie/callback
CIE_IDP_METADATA_URL=https://idserver.servizicie.interno.gov.it/idp/metadata

# ─── STRIPE (Payments) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX
STRIPE_CURRENCY=eur
# Stripe Connect (for multi-branch payouts — optional)
# STRIPE_CONNECT_ENABLED=false

# ─── S3 / MinIO (File Storage) ──────────────────────────
S3_ENDPOINT=http://localhost:9000         # MinIO endpoint for local, omit for AWS S3
S3_REGION=eu-south-1                      # AWS region (Milan)
S3_ACCESS_KEY=mia_minio
S3_SECRET_KEY=mia_minio_pass
S3_BUCKET_PRODUCTS=mia-product-media      # Product images & videos
S3_BUCKET_INVOICES=mia-invoices           # Invoice PDFs & XML
S3_BUCKET_RENTALS=mia-rental-photos       # Rental check-in/out photos
S3_BUCKET_DOCUMENTS=mia-documents         # Agreements, calibration certs
S3_BUCKET_BLOG=mia-blog                   # Blog images
S3_CDN_URL=                               # CDN URL prefix (e.g. https://cdn.miamedicalitalia.it)

# ─── EMAIL (SMTP) ───────────────────────────────────────
MAIL_HOST=smtp.gmail.com                  # SMTP host
MAIL_PORT=587                             # SMTP port (587 for TLS, 465 for SSL)
MAIL_SECURE=false                         # true for port 465
MAIL_USER=noreply@miamedicalitalia.it
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM="MIA Medical Italia" <noreply@miamedicalitalia.it>
# Optional: SendGrid / Mailgun / SES
# MAIL_PROVIDER=smtp                      # smtp | sendgrid | ses
# SENDGRID_API_KEY=

# ─── TWILIO (SMS) ───────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+39XXXXXXXXXX        # Italian number
# Twilio Verify (phone verification)
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXX

# ─── FIREBASE (Push Notifications — FCM) ────────────────
FCM_ENABLED=false
FIREBASE_PROJECT_ID=mia-medical
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mia-medical.iam.gserviceaccount.com

# ─── SDI (Italian Electronic Invoicing) ─────────────────
SDI_ENABLED=false
SDI_PROVIDER=fattureincloud              # fattureincloud | aruba | internal
SDI_API_KEY=CHANGE_ME
SDI_API_URL=https://api-v2.fattureincloud.it
SDI_ENVIRONMENT=sandbox                   # sandbox | production
# Digital certificate for signing (if using internal provider)
# SDI_SIGN_CERT_PATH=./certs/sdi-cert.p12
# SDI_SIGN_CERT_PASSWORD=

# ─── SENTRY (Error Tracking) ────────────────────────────
SENTRY_ENABLED=false
SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_TRACES_SAMPLE_RATE=0.1            # 10% of transactions

# ─── RATE LIMITING ──────────────────────────────────────
THROTTLE_TTL=60                           # Window in seconds
THROTTLE_LIMIT=100                        # Max requests per window per IP
THROTTLE_LOGIN_TTL=300                    # Login: 5 min window
THROTTLE_LOGIN_LIMIT=5                    # Login: max 5 attempts

# ─── SWAGGER / API DOCS ────────────────────────────────
SWAGGER_ENABLED=true                      # Disable in production
SWAGGER_TITLE="MIA Medical Italia API"
SWAGGER_DESCRIPTION="Backend API for MIA Medical Italia platform"
SWAGGER_VERSION=1.0

# ─── LOGGING ────────────────────────────────────────────
LOG_LEVEL=debug                           # debug | info | warn | error
LOG_FORMAT=text                           # text | json (use json in prod)
# LOG_FILE=./logs/app.log                 # Optional: log to file

# ─── GEOSPATIAL (Store Locator) ─────────────────────────
# External routing API for drive-time calculations
GEO_PROVIDER=osrm                         # osrm | google
# Google Directions API (if using Google)
# GOOGLE_MAPS_API_KEY=
# OSRM endpoint (self-hosted or public)
OSRM_ENDPOINT=https://router.project-osrm.org

# ─── SEARCH (Phase 2 — Optional) ────────────────────────
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=CHANGE_ME

# ─── SESSION / SECURITY ────────────────────────────────
BCRYPT_ROUNDS=12                          # Password hashing rounds
PASSWORD_RESET_EXPIRY=1h                  # Password reset token expiry
EMAIL_VERIFY_EXPIRY=24h                   # Email verification expiry
COOKIE_SECURE=false                       # true in production (HTTPS only)
COOKIE_DOMAIN=localhost                   # .miamedicalitalia.it in prod

# ─── QUEUE (BullMQ) ────────────────────────────────────
# Uses same Redis connection. Separate config if needed:
# QUEUE_REDIS_HOST=localhost
# QUEUE_REDIS_PORT=6379
QUEUE_DEFAULT_ATTEMPTS=3                  # Retry failed jobs 3 times
QUEUE_DEFAULT_BACKOFF=5000                # 5s backoff between retries
